{
  "name": "@ikutoku/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production --minify",
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply ikutoku-reservation --local",
    "db:migrate:remote": "wrangler d1 migrations apply ikutoku-reservation --remote --env production",
    "db:seed": "npm run db:seed:clear && wrangler d1 execute ikutoku-reservation --local --file seed/seed.sql",
    "db:seed:clear": "wrangler d1 execute ikutoku-reservation --local --file seed/clear.sql",
    "setup-otp": "node --experimental-strip-types scripts/setup-otp.ts"
  },
  "dependencies": {
    "@ikutoku/shared": "*",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.11",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.143.0"
  }
}
