{
  "name": "ikutoku-reservation",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "deploy": "vite build && wrangler deploy",
    "setup-otp": "node --experimental-strip-types scripts/setup-otp.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p . && tsc -p web",
    "build": "vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.150.0"
  },
  "private": true,
  "type": "module"
}
